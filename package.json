{
  "name": "notes-app",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "test": "jest",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run server\" \"npm --prefix web run dev\"",
    "test:e2e": "playwright test"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.19.2",
    "chalk": "^3.0.0",
    "validator": "^12.1.0",
    "yargs": "^15.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "description": "",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "\\.e2e\\.spec\\.ts$"
    ]
  }
}
